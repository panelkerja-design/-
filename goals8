    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0) !important;
    -webkit-mask-composite: xor !important;
    mask-composite: exclude !important;
    filter: none !important;
    animation: none !important;
}
/* kilau sweep biru dongker */
.faq-box::after {
    content: "" !important;
    position: absolute !important;
    top: 0; left: -130% !important;
    width: 38% !important; height: 100% !important;
    background: linear-gradient(90deg,
        rgba(10,26,120,0) 0%,
        rgba(30,70,200,0.50) 35%,
        rgba(60,120,255,0.72) 50%,
        rgba(30,70,200,0.50) 65%,
        rgba(10,26,120,0) 100%) !important;
    transform: skewX(-18deg) !important;
    animation: navyShine 4.6s ease-in-out 0.5s infinite !important;
    pointer-events: none !important;
    clip-path: none !important;
    right: auto !important;
}
.faq-title { color: #0a1240 !important; text-shadow: 0 1px 1px rgba(180,210,255,0.6) !important; }
