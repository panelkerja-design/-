.faq-q     { color: #0a1240 !important; }
.faq-a-inner { color: #111a40 !important; }
.faq-item {
    background: rgba(200,218,255,0.30) !important;
    border: 1px solid rgba(80,120,255,0.32) !important;
}
.faq-arrow {
    background: rgba(180,210,255,0.45) !important;
    border: 1px solid rgba(60,100,220,0.40) !important;
