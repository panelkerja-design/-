/* kilau sweep biru dongker */
.ax-info-box::after {
    content: "" !important;
    position: absolute !important;
    top: 0; left: -130% !important;
    width: 38% !important; height: 100% !important;
    background: linear-gradient(90deg,
        rgba(10,26,120,0) 0%,
        rgba(30,70,200,0.50) 35%,
        rgba(60,120,255,0.70) 50%,
        rgba(30,70,200,0.50) 65%,
        rgba(10,26,120,0) 100%) !important;
