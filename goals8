/* ============================================================
   2. ax-info-box — Glass biru dongker
   ============================================================ */
.ax-info-box {
    background: rgba(215,228,255,0.24) !important;
    backdrop-filter: blur(20px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(160%) !important;
    border: 1px solid rgba(80,120,255,0.42) !important;
