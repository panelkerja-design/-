                ticks++;
                if (ticks >= maxTicks) {
                    clearInterval(interval);
                    const finalNum = getRandom4();
                    box.textContent = finalNum;
                    box.classList.remove('rolling');
                    box.classList.add('result');
                    btn.disabled = false;
                    btn.textContent = 'Re-Generate';
                }
            }, 70);
        });
    });
})();
