<style>
:root {
  --gold1: #004bf1;
  --gold2: #ffd65b;
  --gold3: #fff3b0;
  --bg-gray-dark: #1a1a1a;
  --bg-gray-deep: #0f0f0f;
  --light-glow: rgba(255, 215, 100, 0.25);
}

/* ===== HEADER & KONTAINER ===== */
.site-header,
.global-header,
.context-header,
.site-header__sites,
.site-header__categories {
  background: linear-gradient(135deg, #2b2b2b 0%, #185d68b2 100%) !important;
  border-bottom: 2px solid var(--gold1);
  box-shadow: 0 0 20px rgb(255, 29, 40);
}

/* ===== PANEL & ITEM PREVIEW ===== */
.item-preview,
.purchase-panel,
.box--no-padding {
  position: relative;
  background: radial-gradient(circle at top left, #242424, var(--bg-gray-dark)) !important;
  border-radius: 18px !important;
  border: 2px solid transparent !important;
  padding: 24px !important;
  overflow: hidden;
  z-index: 1;
  box-shadow:
    0 0 20px rgba(255, 29, 40),
    inset 0 0 25px rgba(72, 255, 225, 0.904);
  animation: floatIn 0.8s ease both;
  backdrop-filter: blur(10px);
}

/* === Border Emas Plasma === */
.item-preview::before,
.purchase-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 18px;
  padding: 2px;
  background: conic-gradient(
    from 0deg,
    var(--gold1),
    var(--gold2),
    var(--gold3),
    var(--gold1)
  );
  background-size: 300%;
  -webkit-mask: linear-gradient(#504f4fcc 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  animation: borderFlow 6s linear infinite;
  z-index: 2;
  pointer-events: none;
}

@keyframes borderFlow {
  0% { background-position: 0% 50%; filter: hue-rotate(0deg); }
  50% { background-position: 200% 50%; filter: hue-rotate(45deg); }
  100% { background-position: 400% 50%; filter: hue-rotate(0deg); }
}

/* === Efek Plasma Gelombang Cahaya === */
.item-preview::after,
.purchase-panel::after {
  content: "";
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background:
    radial-gradient(circle, rgba(255, 235, 160, 0.08), transparent 70%),
    linear-gradient(120deg, rgba(255, 200, 50, 0.04), transparent 80%);
  animation: auroraSwirl 14s infinite linear;
  z-index: 0;
  mix-blend-mode: overlay;
}
@keyframes auroraSwirl {
  0% { transform: rotate(0deg) scale(1); opacity: 0.4; }
  50% { transform: rotate(180deg) scale(1.05); opacity: 0.7; }
  100% { transform: rotate(360deg) scale(1); opacity: 0.4; }
}

/* === Efek Hover: Energi Menyala === */
.item-preview:hover,
.purchase-panel:hover {
  transform: translateY(-3px) scale(1.01);
  transition: all 0.3s ease-in-out;
  box-shadow:
    0 0 35px rgba(255, 200, 80, 0.25),
    0 0 60px rgba(255, 200, 50, 0.12),
    inset 0 0 20px rgba(255, 240, 190, 0.05);
}
.item-preview:hover::before,
.purchase-panel:hover::before {
  filter: brightness(1.25);
}

/* === Efek Cahaya Mengalir di Tengah === */
.item-preview .inner-glow,
.purchase-panel .inner-glow {
  position: absolute;
  top: -30%;
  left: -30%;
  width: 160%;
  height: 160%;
  background: radial-gradient(circle at center, var(--light-glow), transparent 70%);
  opacity: 0.2;
  animation: pulseLight 6s infinite ease-in-out;
  z-index: 1;
  mix-blend-mode: screen;
}
@keyframes pulseLight {
  0%, 100% { transform: scale(1); opacity: 0.2; }
  50% { transform: scale(1.3); opacity: 0.35; }
}

/* === TEKS === */
.purchase-panel h3,
.purchase-panel .price,
.purchase-panel p,
.purchase-panel label,
.purchase-panel a,
.purchase-panel .meta-attributes__attr-name,
.purchase-panel .meta-attributes__attr-detail {
  color: #fff !important;
  text-shadow: 0 1px 4px rgba(0,0,0,0.6);
}

.purchase-panel a {
  color: #ffe79a !important;
  transition: 0.3s ease;
}
.purchase-panel a:hover {
  color: #ffffff !important;
  text-shadow: 0 0 10px #ffdd66;
}

/* === ENTRANCE ANIM === */
@keyframes floatIn {
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0); }
}

/* === RESPONSIVE === */
@media (max-width: 640px) {
  .item-preview,
  .purchase-panel {
    padding: 18px !important;
    border-radius: 12px !important;
  }
}
</style>

